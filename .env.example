# Copy to .env. Local development works without a .env at all (safe defaults in docker-compose.yml).
# For production (docker-compose.prod.yml) you MUST set the values marked REQUIRED.

# --- Production ---------------------------------------------------------------
# Your domain (DNS A record pointing at the server) -> automatic free HTTPS.
# Use :80 for a shop-LAN install without a domain (plain HTTP on the local network only).
DOMAIN=pos.example.com
ACME_EMAIL=you@example.com

# REQUIRED: generate with:  openssl rand -hex 32
JWT_SECRET=
# REQUIRED: a long random database password
POSTGRES_PASSWORD=
POSTGRES_USER=tallyko
POSTGRES_DB=tallyko

# Comma-separated browser origins allowed to call the API. "*" is fine when the web app is served by
# the same Caddy (same origin). Restrict it if you host the web app elsewhere.
CORS_ORIGINS=*
TIMEZONE=Asia/Kolkata
WEB_CONCURRENCY=2

# --- Customer email (optional) ---
# Any SMTP account (e.g. your domain's mailbox or a free-tier SMTP relay). Leave SMTP_HOST empty to log emails as "skipped".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=no-reply@pos.example.com
SMTP_FROM_NAME=Tallyko
# Links in emails point here (defaults to https://$DOMAIN)
# PUBLIC_APP_URL=https://pos.example.com

# --- Android APK build (docker compose --profile android run --rm android-build) ---
# Server address baked into the app as the default (users can still change it on the login screen)
APK_API_URL=https://pos.example.com/api/v1
APP_VERSION_CODE=1
