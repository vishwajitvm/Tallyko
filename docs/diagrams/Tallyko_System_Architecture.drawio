        <mxCell id="caddy" value="&lt;b&gt;Caddy 2&lt;/b&gt; (web container)&lt;br&gt;automatic HTTPS (Let's Encrypt) · serves the static web build&lt;br&gt;proxies /api/* and /health → backend:8000 · security headers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="g_edge">
          <mxGeometry x="420" y="36" width="440" height="62" as="geometry" />
        </mxCell>
