        <mxCell id="title" value="&lt;b&gt;Tallyko · System architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Production runtime: clients → Caddy → FastAPI → PostgreSQL (RLS) and Redis, with in-process background tasks&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
