        </mxCell>
        <mxCell id="c_kds" value="&lt;b&gt;Kitchen display&lt;/b&gt;&lt;br&gt;same app, kitchen role&lt;br&gt;wall TV / tablet · polls every 5 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="g_clients">
          <mxGeometry x="626" y="36" width="190" height="88" as="geometry" />
