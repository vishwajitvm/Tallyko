        <mxCell id="c_admin" value="&lt;b&gt;Super admin console&lt;/b&gt;&lt;br&gt;/admin routes&lt;br&gt;platform logins: super_admin, support" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="g_clients">
          <mxGeometry x="828" y="36" width="190" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_store" value="&lt;b&gt;Customer pages (no login)&lt;/b&gt;&lt;br&gt;/store/{tenantId} online store&lt;br&gt;?table={id} QR table ordering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="g_clients">
          <mxGeometry x="1030" y="36" width="190" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c_device" value="&lt;b&gt;On every staff device:&lt;/b&gt; offline cache (store/data: menu, tables, settings, tax classes) · &lt;b&gt;outbox&lt;/b&gt; of bills made offline (client-generated order ids, replayed by POST /sync/push, kept on 401/402) · printing over ESC/POS (Bluetooth Classic / BLE / Web Bluetooth) or the system print dialog · barcodes Code128, EAN-13, QR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;spacing=4;fillColor=#ffffff;strokeColor=#6c8ebf;rounded=1;dashed=1;" vertex="1" parent="g_clients">
