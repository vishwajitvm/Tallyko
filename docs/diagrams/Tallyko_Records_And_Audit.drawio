  <diagram id="tallyko-records-and-audit-archive-delete-and-menu-versions" name="Archive, delete and menu versions">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Tallyko · Records and audit · archive, hard delete and menu versions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Super admin corrections (services/records_admin.py) and append-only menu history (services/menu_history.py)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title_meta" value="&lt;b&gt;v2.0.0&lt;/b&gt;&lt;br&gt;2026-10-25" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#0f766e;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1520" y="20" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad" value="Archive and hard delete · super admin only · platform router, system session" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#eeeeee;swimlaneFillColor=#fafafa;strokeColor=#666666;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1660" height="420" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Console → business detail → &lt;b&gt;Records&lt;/b&gt;: search bills incl. archived · GET /platform/businesses/{id}/orders" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ad">
          <mxGeometry x="20" y="60" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Archive or delete?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="ad">
          <mxGeometry x="320" y="65" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Archive&lt;/b&gt;: POST …/orders/archive · running bills cancelled first · archived_at + reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ad">
          <mxGeometry x="560" y="40" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Hidden from lists and reports · GST invoice numbers stay continuous · undo with …/orders/unarchive" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ad">
          <mxGeometry x="900" y="40" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="Every action → &lt;b&gt;platform_audit_logs&lt;/b&gt; (actor, business, details)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="ad">
          <mxGeometry x="1260" y="40" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;Hard delete&lt;/b&gt;: POST …/orders/delete · bill_snapshot() of each bill first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="ad">
          <mxGeometry x="560" y="200" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Reversed like a cancel: stock (inventory_logs), loyalty points, offer usage · then payments, order_items, kots, offer_redemptions, the bill's inventory_logs and the order are deleted · email_logs unlinked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="ad">
          <mxGeometry x="900" y="200" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="Snapshot kept in &lt;b&gt;platform_audit_logs&lt;/b&gt; · the console warns that GST invoice numbers will have a gap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="ad">
          <mxGeometry x="1260" y="200" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ad_note" value="Archive is preferred. Hard delete is permanent and Tallyko-only; a business can do neither." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;spacing=4;" vertex="1" parent="ad">
          <mxGeometry x="20" y="340" width="860" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d1_d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_d3" value="archive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3">
