        <mxCell id="w5" value="&lt;b&gt;WatchScreen&lt;/b&gt; (owner only)&lt;br&gt;GET /owner/watch · /owner/watch/events&lt;br&gt;filter by day, staff and kind; open the bill or the item's history" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="watch">
          <mxGeometry x="440" y="120" width="340" height="140" as="geometry" />
