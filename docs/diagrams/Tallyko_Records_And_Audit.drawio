  <diagram id="tallyko-records-and-audit-nothing-deleted-and-the-owner-s-watch" name="Nothing deleted and the owner's watch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Tallyko · Records and audit · nothing deleted by a business&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Database grants make deletion impossible for the app; the owner watches what staff change and asks Tallyko for corrections&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title_meta" value="&lt;b&gt;v2.0.0&lt;/b&gt;&lt;br&gt;2026-10-25" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#0f766e;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1520" y="20" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="grants" value="Database role grants · migration 0059 · role tallyko_app" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#e1d5e7;swimlaneFillColor=#f9f6fb;strokeColor=#9673a6;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="820" height="420" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;No DELETE&lt;/b&gt; (SELECT, INSERT, UPDATE): orders, payments, kots, customers, products, product_categories, inventory_logs, tables" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="grants">
          <mxGeometry x="20" y="40" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;Append-only&lt;/b&gt; (SELECT, INSERT): audit_logs, product_versions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="grants">
          <mxGeometry x="20" y="135" width="780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Other tenant tables: SELECT, INSERT, UPDATE, DELETE · every tenant table has the RLS policy tenant_id = app.current_tenant_id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=6;" vertex="1" parent="grants">
          <mxGeometry x="20" y="210" width="780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;So a business cancels or hides instead of deleting&lt;/b&gt;&lt;br&gt;bill → status cancelled · line → removed / void · comp → price 0 · menu item, category, table, offer, brand → is_active false · staff → is_active false&lt;br&gt;Only Tallyko's super admin archives or deletes, through a system session." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=11;spacing=6;" vertex="1" parent="grants">
          <mxGeometry x="20" y="290" width="780" height="110" as="geometry" />
        </mxCell>
        <mxCell id="watch" value="Owner's watch · owner only" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#ffe6cc;swimlaneFillColor=#fff9f2;strokeColor=#d79b00;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="800" height="420" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="&lt;b&gt;audit_logs&lt;/b&gt;: order.cancel, order.void, order.comp, order.discount, staff and settings changes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="watch">
          <mxGeometry x="20" y="40" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;order_items&lt;/b&gt;: void, removed and comp lines with reason and staff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="watch">
          <mxGeometry x="20" y="115" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="&lt;b&gt;orders&lt;/b&gt;: cancelled bills, discounts, bills archived by Tallyko" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="watch">
          <mxGeometry x="20" y="190" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="&lt;b&gt;product_versions&lt;/b&gt;: menu changes made by staff (price, tax, hidden)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="watch">
          <mxGeometry x="20" y="265" width="360" height="60" as="geometry" />
