  <diagram id="tallyko-access-and-sessions-access-model" name="Access model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="860" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Tallyko · Access and sessions · access model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What a signed-in staff member may do: plan modules × overrides × owner-hidden modules × role permissions&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title_meta" value="&lt;b&gt;v2.0.0&lt;/b&gt;&lt;br&gt;2026-10-25" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#0f766e;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1520" y="20" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="in" value="Inputs" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#e1d5e7;swimlaneFillColor=#f9f6fb;strokeColor=#9673a6;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="&lt;b&gt;plans.features&lt;/b&gt; · modules in the business's plan (catalog.FEATURES, DEFAULT_PLANS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="in">
          <mxGeometry x="20" y="40" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="&lt;b&gt;tenant_configs.feature_overrides&lt;/b&gt; · super admin adds or removes modules for one business" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="in">
          <mxGeometry x="20" y="125" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="&lt;b&gt;business_settings.disabled_modules&lt;/b&gt; · modules the owner chose to hide" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="in">
          <mxGeometry x="20" y="210" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="&lt;b&gt;roles.permissions&lt;/b&gt; · the staff member's role: owner, manager, cashier, waiter, kitchen or a custom role" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="in">
          <mxGeometry x="20" y="330" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i5" value="&lt;b&gt;PERMISSION_FEATURE&lt;/b&gt; · each permission belongs to a module (catalog.py)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="in">
          <mxGeometry x="20" y="415" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i6" value="&lt;b&gt;plans.limits&lt;/b&gt; + &lt;b&gt;tenant_configs.limit_overrides&lt;/b&gt; · max staff, products, locations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="in">
          <mxGeometry x="20" y="510" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="calc" value="services/access.py" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;Enabled modules&lt;/b&gt; = plan features ± overrides − owner-hidden&lt;br&gt;entitlements(tenant_id), cached 30 s per process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="calc">
          <mxGeometry x="20" y="120" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Effective permissions&lt;/b&gt; = role permissions whose module is enabled&lt;br&gt;effective_permissions(role_perms, features) → Access" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="calc">
          <mxGeometry x="20" y="370" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Limits&lt;/b&gt; · check_limit() when adding staff, products or locations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="calc">
          <mxGeometry x="20" y="510" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="use" value="Where it is enforced" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#ffe6cc;swimlaneFillColor=#fff9f2;strokeColor=#d79b00;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="100" width="500" height="600" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="&lt;b&gt;require(&quot;perm.code&quot;, feature=&quot;module&quot;)&lt;/b&gt; on every business route → 403 when missing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="use">
          <mxGeometry x="20" y="40" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="access.can(permission) / access.has(module) for finer checks inside a route" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="use">
          <mxGeometry x="20" y="140" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="&lt;b&gt;GET /access/me&lt;/b&gt; → the app hides nav items and buttons (navItems filtered by role and business type)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="use">
          <mxGeometry x="20" y="230" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="Token kinds: platform tokens (super_admin, support) get 403 on business routes; business tokens get 403 on /platform. The owner role holds every permission of the enabled modules." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=10;spacing=6;" vertex="1" parent="use">
          <mxGeometry x="20" y="330" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="Changes apply at once: invalidate(tenant_id) after role, module or plan changes; a staff member whose access changed is signed out (sessions.revoke)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=10;spacing=6;" vertex="1" parent="use">
          <mxGeometry x="20" y="460" width="460" height="110" as="geometry" />
        </mxCell>
