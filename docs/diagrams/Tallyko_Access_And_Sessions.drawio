        <mxCell id="trig" value="Ways a device gets signed out" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#ffe6cc;swimlaneFillColor=#fff9f2;strokeColor=#d79b00;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="640" height="580" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="This device signs out · POST /auth/logout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="trig">
          <mxGeometry x="20" y="40" width="600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Owner or staff ends another device · DELETE /auth/sessions/{id}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="trig">
          <mxGeometry x="20" y="116" width="600" height="60" as="geometry" />
        </mxCell>
