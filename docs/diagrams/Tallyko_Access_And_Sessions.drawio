          <mxGeometry x="20" y="268" width="600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="Super admin revokes one session · POST /platform/sessions/{id}/revoke" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="trig">
