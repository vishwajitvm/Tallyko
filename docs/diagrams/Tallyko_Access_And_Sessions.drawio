  <diagram id="tallyko-access-and-sessions-request-pipeline" name="Request pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1130" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Tallyko · Access and sessions · request pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Every authenticated business request passes these checks before a router runs (core/security.py, core/tenant.py)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title_meta" value="&lt;b&gt;v2.0.0&lt;/b&gt;&lt;br&gt;2026-10-25" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#0f766e;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1520" y="20" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q0" value="Request · Authorization: Bearer &amp;lt;access token, 12 h&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="Caddy → backend · rate limits in Redis (per account / per phone; high per-IP ceilings: a shop shares one IP)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="q1_x" value="429 · too many requests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="207" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_q1_x" value="over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q1_x">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="Decode JWT: signature, type “access”, not expired" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="290" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="q2_x" value="401 · session expired" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="297" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_q2_x" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="q2_x">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="Business token? (tokens with platform_role are refused here)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="380" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="q3_x" value="403 · platform accounts can't use business screens" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="387" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_q3_x" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="q3_x">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q4" value="Tenant config from the Redis cache: status, paid_until, session_version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="q4_x" value="401 · business not found" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="477" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_q4_x" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="q4_x">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q5" value="Token sv = tenant_configs.session_version and sid not in the Redis revoked set" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="q5_x" value="401 · signed out of this device" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="1">
