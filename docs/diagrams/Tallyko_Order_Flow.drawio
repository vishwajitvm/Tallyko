        </mxCell>
        <mxCell id="n1" value="Cashier taps items&lt;br&gt;(or scans a barcode)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="l_pos">
          <mxGeometry x="60" y="45" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Cart: product_id, variant_id, quantity, notes · customer phone · chosen offer&lt;br&gt;&lt;b&gt;no prices or totals are sent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_pos">
          <mxGeometry x="300" y="45" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Live total preview&lt;br&gt;lib/billing.ts mirrors the server maths (display only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_pos">
          <mxGeometry x="620" y="45" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;POST /api/v1/orders&lt;/b&gt; {id: client UUID, type, channel, table?, items}&lt;br&gt;or POST /orders/{id}/items on a running bill" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_pos">
          <mxGeometry x="910" y="45" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="No network? The bill goes to the &lt;b&gt;outbox&lt;/b&gt; and is replayed later with the same id (see the Offline page)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#c9b458;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="l_pos">
          <mxGeometry x="1280" y="40" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l_price" value="Server pricing&lt;br&gt;order_service._price → pricing" style="swimlane;horizontal=0;html=1;whiteSpace=wrap;startSize=40;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="1660" height="240" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="Check every id belongs to the business, is active and sold on this channel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="l_price">
          <mxGeometry x="60" y="50" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · Channel price&lt;/b&gt;&lt;br&gt;channel_menu.unit_price: item price on this channel or mark-up, + variant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="l_price">
