        <mxCell id="s2a" value="&lt;b&gt;Bill of Supply&lt;/b&gt;: no GST lines" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="l_price">
          <mxGeometry x="480" y="165" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;2 · GST class in effect now&lt;/b&gt;&lt;br&gt;TaxResolver: product's tax class, dated tax_class_rates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="l_price">
