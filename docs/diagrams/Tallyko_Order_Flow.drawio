  <diagram id="tallyko-order-flow-offline" name="Offline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1340" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Tallyko · Order flow · offline bills&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Bills made without a network go to the outbox and replay through POST /sync/push with the same client id&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title_meta" value="&lt;b&gt;v2.0.0&lt;/b&gt;&lt;br&gt;2026-10-25" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#0f766e;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1520" y="20" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l_device" value="Staff device · Expo app" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#dae8fc;swimlaneFillColor=#f4f8fd;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="820" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="l_server" value="Tallyko API · /api/v1/sync" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="820" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="A call fails with ApiError.network&lt;br&gt;OfflineBanner shows “offline”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_device">
          <mxGeometry x="200" y="40" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Bill made from the &lt;b&gt;offline cache&lt;/b&gt; (store/data: menu, tables, settings, tax classes)&lt;br&gt;order id = client-generated UUID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_device">
          <mxGeometry x="200" y="140" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Receipt printed locally · bill saved in the &lt;b&gt;outbox&lt;/b&gt; (store/outbox, persisted on the device)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_device">
          <mxGeometry x="200" y="250" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Network is back → lib/sync pushes the queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_device">
          <mxGeometry x="200" y="360" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_d1_d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d3_d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_note" value="&lt;b&gt;Why replays are safe&lt;/b&gt;&lt;br&gt;• The order id is the idempotency key: a bill pushed twice is stored once.&lt;br&gt;• The server re-prices every line; the device total is only a preview.&lt;br&gt;• Offers are evaluated online only: offline bills sync without an offer.&lt;br&gt;• 402 (subscription locked) pauses pushing and keeps the queue; 401 keeps it too until the user signs in again.&lt;br&gt;• Outbox bills are listed under Orders → Offline bills until they sync." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#c9b458;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="l_device">
          <mxGeometry x="160" y="470" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;Result per bill&lt;/b&gt;&lt;br&gt;saved → removed from the outbox · rejected → stays and shows in Offline bills" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_device">
          <mxGeometry x="200" y="900" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Cache refresh: lib/sync pulls rows changed since the last updated_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="l_device">
          <mxGeometry x="200" y="1000" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_d5_d6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d5" target="d6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;POST /api/v1/sync/push&lt;/b&gt;&lt;br&gt;batch of outbox bills (same ids)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="l_server">
          <mxGeometry x="80" y="360" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Order id already on the server?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="l_server">
          <mxGeometry x="160" y="455" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;yes&lt;/b&gt; → nothing new; the stored bill is returned (idempotent replay)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="l_server">
          <mxGeometry x="460" y="470" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;no&lt;/b&gt; → order_service.create_order: channel price, GST class at that time, discount, round-off" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="l_server">
          <mxGeometry x="80" y="590" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Table got another bill meanwhile → this one is saved as a &lt;b&gt;separate bill&lt;/b&gt; on that table" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="l_server">
