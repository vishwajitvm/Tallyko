        <mxCell id="a3" value="&lt;b&gt;Split&lt;/b&gt;: move items&lt;br&gt;POST /orders/{id}/items/move → another bill or a new bill (bill_label)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="280" y="276" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="lines keep their kitchen status; both bills are re-priced" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="840" y="276" width="440" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e_a3_r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;Merge bills&lt;/b&gt;&lt;br&gt;POST /orders/{target}/merge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="280" y="342" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="items join the target bill; the source is closed as merged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="840" y="342" width="440" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e_a4_r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;Transfer table&lt;/b&gt;&lt;br&gt;POST /orders/{id}/transfer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="280" y="408" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="the bill moves; the old table is freed when empty" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="840" y="408" width="440" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e_a5_r5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="r5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;Cancel the whole bill&lt;/b&gt;&lt;br&gt;POST /orders/{id}/cancel with a reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="280" y="474" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="status cancelled (kept) · stock and loyalty reversed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_change">
          <mxGeometry x="840" y="474" width="440" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e_a6_r6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a6" target="r6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• Lines can't change after a payment was taken: refund or cancel instead.&lt;br&gt;• Free offer lines follow the offer.&lt;br&gt;• Totals are always recomputed by the server (pricing pipeline).&lt;br&gt;• audit.record(…) writes audit_logs for cancel, void, comp, discount and moves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;spacing=4;" vertex="1" parent="g_change">
          <mxGeometry x="1310" y="40" width="330" height="220" as="geometry" />
