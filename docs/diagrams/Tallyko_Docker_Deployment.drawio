        </mxCell>
        <mxCell id="d_editor" value="&lt;b&gt;Editor + terminal&lt;/b&gt;&lt;br&gt;docker compose up --watch (live reload on Windows / macOS)&lt;br&gt;scripts/: setup (random secrets) · dev · db · migrate · backup_db / restore_db" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="d_dev">
          <mxGeometry x="1140" y="36" width="500" height="76" as="geometry" />
        </mxCell>
        <mxCell id="d_compose" value="docker compose (project “tallyko”) · default network · docker compose up -d --build" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="1660" height="640" as="geometry" />
        </mxCell>
        <mxCell id="d_mailpit" value="&lt;b&gt;mailpit&lt;/b&gt; · axllent/mailpit:v1.27&lt;br&gt;UI 127.0.0.1:8025 · SMTP mailpit:1025&lt;br&gt;catches every email; nothing leaves the machine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eeeeee;strokeColor=#666666;fontSize=10;spacing=6;" vertex="1" parent="d_compose">
          <mxGeometry x="20" y="70" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d_backend" value="&lt;b&gt;backend&lt;/b&gt; · build ./backend (target dev)&lt;br&gt;port 8000 · bind mount ./backend → /app&lt;br&gt;CMD: manage.py migrate → manage.py watch (auto-migrate) → uvicorn --reload&lt;br&gt;WATCHFILES_FORCE_POLLING · SMTP_HOST=mailpit · healthcheck /health&lt;br&gt;email worker + 01:00 IST scheduler run in-process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="d_compose">
          <mxGeometry x="380" y="60" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d_web" value="&lt;b&gt;web&lt;/b&gt; · build ./frontend (target dev)&lt;br&gt;Expo web dev server on port 8081&lt;br&gt;EXPO_PUBLIC_API_URL = http://localhost:8000/api/v1&lt;br&gt;&lt;b&gt;Compose Watch:&lt;/b&gt; sync src/, assets/, public/ · rebuild on package.json · sync+restart on app.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="d_compose">
          <mxGeometry x="800" y="60" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d_db" value="&lt;b&gt;db&lt;/b&gt; · postgres:15-alpine&lt;br&gt;127.0.0.1:5433 → 5432 (local tools only)&lt;br&gt;database tallyko_shared (RLS)&lt;br&gt;tests: tallyko_shared_test (created by pytest)&lt;br&gt;healthcheck pg_isready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="d_compose">
          <mxGeometry x="380" y="290" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d_cache" value="&lt;b&gt;cache&lt;/b&gt; · redis:7-alpine&lt;br&gt;redis://cache:6379 · DB 0 app, DB 1 tests&lt;br&gt;save 60 1 · healthcheck redis-cli ping" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="d_compose">
          <mxGeometry x="800" y="290" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_pytest" value="&lt;b&gt;Tests&lt;/b&gt;&lt;br&gt;docker compose exec backend python -m pytest -q&lt;br&gt;own database &amp;lt;db&amp;gt;_test + Redis DB 1: never touches dev data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="d_compose">
          <mxGeometry x="20" y="290" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d_manage" value="&lt;b&gt;manage.py&lt;/b&gt; (docker compose exec backend python manage.py …)&lt;br&gt;migrate · rollback · status · make:migration (one per table) · db:sync · db:check&lt;br&gt;refresh · fresh · seed (demo data, password Demo@1234) · create:superadmin&lt;br&gt;watch · subscriptions:check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=10;spacing=6;" vertex="1" parent="d_compose">
          <mxGeometry x="1160" y="170" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_order" value="&lt;b&gt;Start order&lt;/b&gt; (depends_on + healthchecks): db, cache, mailpit → backend (after db and cache are healthy) → web (after backend is healthy)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;spacing=4;" vertex="1" parent="d_compose">
          <mxGeometry x="1160" y="320" width="480" height="80" as="geometry" />
        </mxCell>
