        <mxCell id="d_browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;http://localhost:8081 web app · http://localhost:8000/docs API (Swagger) · http://localhost:8025 Mailpit inbox · Postgres tools on 127.0.0.1:5433" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="d_dev">
