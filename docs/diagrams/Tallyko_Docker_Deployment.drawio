        <mxCell id="d_dev" value="Your machine (Windows / macOS / Linux) · Docker Desktop is the only install" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#dae8fc;swimlaneFillColor=#f4f8fd;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
