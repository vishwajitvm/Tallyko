        <mxCell id="p_c_apps" value="&lt;b&gt;Android and iOS apps&lt;/b&gt;&lt;br&gt;server URL set in the app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="p_clients">
          <mxGeometry x="346" y="36" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p_c_kds" value="&lt;b&gt;Kitchen displays&lt;/b&gt;&lt;br&gt;poll every 5 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="p_clients">
          <mxGeometry x="672" y="36" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p_c_cust" value="&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;QR table ordering · online store" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="p_clients">
          <mxGeometry x="998" y="36" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p_c_admin" value="&lt;b&gt;Super admin console&lt;/b&gt;&lt;br&gt;/admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="p_clients">
          <mxGeometry x="1324" y="36" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p_server" value="Linux server · docker compose -f docker-compose.prod.yml up -d --build (project “tallyko-prod”) · restart: always · json-file logs 10 MB × 5" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="260" width="1240" height="730" as="geometry" />
        </mxCell>
        <mxCell id="p_web" value="&lt;b&gt;web&lt;/b&gt; · Caddy 2 (frontend Dockerfile, target prod)&lt;br&gt;ports 80, 443, 443/udp (HTTP/3) · SITE_ADDRESS=$DOMAIN&lt;br&gt;automatic Let's Encrypt certificate · serves the static web build&lt;br&gt;proxies /api/* and /health · gzip / zstd · security headers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="p_server">
          <mxGeometry x="360" y="40" width="520" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p_backend" value="backend · target prod · non-root user “tallyko” · healthcheck GET /health (DB + Redis) · on start: manage.py migrate, then uvicorn --workers ${WEB_CONCURRENCY:-2} --proxy-headers" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p_server">
          <mxGeometry x="40" y="180" width="1160" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p_w1" value="&lt;b&gt;uvicorn worker 1&lt;/b&gt;&lt;br&gt;FastAPI app · /api/v1&lt;br&gt;+ email worker task (SKIP LOCKED)&lt;br&gt;+ subscription scheduler task&lt;br&gt;(only the worker holding the Redis lock runs the 01:00 IST check)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="p_backend">
          <mxGeometry x="20" y="40" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p_w2" value="&lt;b&gt;uvicorn worker 2&lt;/b&gt;&lt;br&gt;FastAPI app · /api/v1&lt;br&gt;+ email worker task (SKIP LOCKED)&lt;br&gt;+ subscription scheduler task&lt;br&gt;(only the worker holding the Redis lock runs the 01:00 IST check)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="p_backend">
          <mxGeometry x="400" y="40" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p_env" value="&lt;b&gt;.env&lt;/b&gt; (from .env.example, scripts/setup makes random secrets)&lt;br&gt;DOMAIN · ACME_EMAIL · POSTGRES_PASSWORD · JWT_SECRET (required) · SMTP_* · WEB_CONCURRENCY&lt;br&gt;TRUST_PROXY=true · TIMEZONE=Asia/Kolkata&lt;br&gt;refuses to start in production with the default JWT secret or DB password" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=10;spacing=6;" vertex="1" parent="p_backend">
          <mxGeometry x="780" y="40" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p_backup" value="&lt;b&gt;Backups&lt;/b&gt;&lt;br&gt;scripts/backup_db.sh / .ps1: pg_dump of the database&lt;br&gt;restore_db.sh to restore&lt;br&gt;copy dumps off the server (another disk or machine)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="p_server">
          <mxGeometry x="40" y="450" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p_db" value="&lt;b&gt;db&lt;/b&gt; · postgres:15-alpine&lt;br&gt;database $POSTGRES_DB (RLS, role tallyko_app)&lt;br&gt;not published to the network&lt;br&gt;healthcheck pg_isready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="p_server">
          <mxGeometry x="440" y="450" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p_cache" value="&lt;b&gt;cache&lt;/b&gt; · redis:7-alpine&lt;br&gt;maxmemory 128 MB · allkeys-lru · save 300 1&lt;br&gt;not published to the network" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="p_server">
