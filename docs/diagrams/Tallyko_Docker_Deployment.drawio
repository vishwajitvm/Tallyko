        <mxCell id="p_c_staff" value="&lt;b&gt;Staff browsers / PWA&lt;/b&gt;&lt;br&gt;billing, floor, back office" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="p_clients">
