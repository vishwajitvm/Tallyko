        <mxCell id="title" value="&lt;b&gt;Tallyko · Docker deployment · production&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;docker-compose.prod.yml on one server: Caddy (HTTPS) → backend workers → PostgreSQL and Redis; cp .env.example .env first&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
