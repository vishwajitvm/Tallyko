  <diagram id="tallyko-qr-table-ordering-qr-table-ordering" name="QR table ordering">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1960" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Tallyko · QR table ordering&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Customer → public API → staff app → kitchen; pay at the counter or by UPI claim → staff confirm&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=18;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1490" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title_meta" value="&lt;b&gt;v2.0.0&lt;/b&gt;&lt;br&gt;2026-10-25" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#0f766e;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1520" y="20" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ln_cust" value="Customer · phone browser, no login" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#dae8fc;swimlaneFillColor=#f4f8fd;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="410" height="1720" as="geometry" />
        </mxCell>
        <mxCell id="ln_api" value="Tallyko public API · /api/v1/public" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="410" height="1720" as="geometry" />
        </mxCell>
        <mxCell id="ln_staff" value="Staff app" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#ffe6cc;swimlaneFillColor=#fff9f2;strokeColor=#d79b00;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="410" height="1720" as="geometry" />
        </mxCell>
        <mxCell id="ln_kitchen" value="Kitchen display" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#fff2cc;swimlaneFillColor=#fffcf2;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="100" width="400" height="1720" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Scans the table QR → /store/{tenantId}?table={tableId}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_cust">
          <mxGeometry x="20" y="40" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="GET /public/{tenant_id}/menu (QR-channel prices, hidden items left out) · GET /public/{tenant_id}/tables/{table_id}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="140" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Picks items, enters name and phone, chooses “pay at the counter” or “pay by UPI” (qr_payment_mode)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_cust">
          <mxGeometry x="20" y="250" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;POST /public/{tenant_id}/orders&lt;/b&gt; · QR ordering must be on · rate-limited per phone (high per-IP ceiling)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="360" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Open QR bill for this phone on this table?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="470" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;yes&lt;/b&gt; → items added to that bill as a new KOT · Redis idempotency key makes retries safe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="220" y="485" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;no&lt;/b&gt; → new bill on the table · bill_label = first name · placed (open with auto-accept)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="600" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Online / Tables screens show the new QR order (badge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
          <mxGeometry x="20" y="720" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Accept&lt;/b&gt;: POST /orders/{id}/accept → open, KOT to the kitchen (skipped with auto-accept) · or reject" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
          <mxGeometry x="20" y="820" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="Polls every 5 s: pending → preparing → ready" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=6;" vertex="1" parent="ln_kitchen">
          <mxGeometry x="20" y="930" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Tracks the bill (order tracker)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_cust">
          <mxGeometry x="20" y="1040" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="GET /public/{tenant_id}/orders/{id}: items, status, balance, UPI link" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="1040" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Waiter serves → served" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
          <mxGeometry x="20" y="1040" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="How does the customer pay?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="ln_cust">
          <mxGeometry x="20" y="1140" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="At the counter or to the waiter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_cust">
          <mxGeometry x="220" y="1155" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Cashier&lt;/b&gt;: POST /orders/{id}/pay (cash, card, UPI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
          <mxGeometry x="220" y="1155" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;UPI&lt;/b&gt;: upi:// deep link opens the UPI app with the amount and bill code, then taps “I've paid”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_cust">
          <mxGeometry x="20" y="1280" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;b&gt;POST /public/{tenant_id}/orders/{id}/payment-claim&lt;/b&gt; → orders.payment_claim {UPI, amount, reference}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="1280" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Claim shows on the bill (PaymentClaim) · staff check their UPI app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
          <mxGeometry x="20" y="1400" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;confirm&lt;/b&gt;: POST /orders/{id}/payment-claim/confirm → UPI payment recorded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
          <mxGeometry x="20" y="1500" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;reject&lt;/b&gt;: POST /orders/{id}/payment-claim/reject → claim cleared" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
          <mxGeometry x="210" y="1500" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="Paid in full → finalize (invoice, stock, loyalty, emails) · table freed when its last bill closes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="ln_staff">
