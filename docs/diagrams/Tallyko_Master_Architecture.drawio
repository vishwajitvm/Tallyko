          <mxGeometry x="13" y="148" width="200" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g_pub" value="Public and integrations" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="g_api">
          <mxGeometry x="1034" y="38" width="230" height="206" as="geometry" />
        </mxCell>
        <mxCell id="r_public" value="&lt;b&gt;public&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/public/{tenant_id}: menu · QR and online orders · UPI payment claim · rate-limited per phone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_pub">
          <mxGeometry x="15" y="36" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r_integrations" value="&lt;b&gt;integrations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;/integrations/{channel}/orders/{tenant_id}: HMAC-signed aggregator webhook&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_pub">
          <mxGeometry x="15" y="118" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_pipeline" value="&lt;b&gt;Every business request:&lt;/b&gt; get_current_user (JWT · sv / sid · 402 lock) → require(permission, module) → get_tenant_db (SET LOCAL ROLE tallyko_app + app.current_tenant_id, so Postgres RLS filters every query) → thin router" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;spacing=4;fillColor=#ffffff;strokeColor=#82b366;rounded=1;" vertex="1" parent="g_api">
          <mxGeometry x="16" y="254" width="1248" height="36" as="geometry" />
        </mxCell>
        <mxCell id="api_services" value="&lt;b&gt;Services (business rules, app/services):&lt;/b&gt; access · auth_service · sessions · order_service · floor_service · pricing · offers · tax · channel_menu · menu_history · subscription · records_admin · email · audit · counters · menu_ocr · settings_service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=none;spacing=4;fillColor=#ffffff;strokeColor=#82b366;rounded=1;" vertex="1" parent="g_api">
          <mxGeometry x="16" y="296" width="1248" height="36" as="geometry" />
        </mxCell>
        <mxCell id="g_data" value="Data" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#e1d5e7;swimlaneFillColor=#f9f6fb;strokeColor=#9673a6;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="900" width="620" height="170" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Redis 7&lt;/b&gt;&lt;br&gt;tenant config cache (status, paid_until, session_version) · rate limits · revoked session ids · daily-job lock · “add to my bill” idempotency keys" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="g_data">
          <mxGeometry x="16" y="38" width="250" height="116" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL 15&lt;/b&gt; · shared DB with Row-Level Security&lt;br&gt;38 tables (13 platform, 25 business)&lt;br&gt;role tallyko_app: no DELETE on business records; audit_logs and product_versions append-only&lt;br&gt;dedicated DB per tenant: routing only (tenant_configs.db_url)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;spacing=6;" vertex="1" parent="g_data">
          <mxGeometry x="282" y="38" width="322" height="116" as="geometry" />
        </mxCell>
        <mxCell id="g_tasks" value="Background tasks · in-process asyncio tasks started in the API lifespan" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#fff2cc;swimlaneFillColor=#fffcf2;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="900" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t_sched" value="&lt;b&gt;Subscription scheduler&lt;/b&gt;&lt;br&gt;daily 01:00 IST + catch-up on start&lt;br&gt;Redis lock: one worker runs it&lt;br&gt;signs out businesses whose paid_until + grace ended" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=6;" vertex="1" parent="g_tasks">
          <mxGeometry x="16" y="38" width="296" height="116" as="geometry" />
        </mxCell>
        <mxCell id="t_email" value="&lt;b&gt;Email worker&lt;/b&gt;&lt;br&gt;delivers the email_logs queue&lt;br&gt;FOR UPDATE SKIP LOCKED (safe across workers)&lt;br&gt;status queued → sent / failed / skipped" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;spacing=6;" vertex="1" parent="g_tasks">
          <mxGeometry x="328" y="38" width="296" height="116" as="geometry" />
        </mxCell>
        <mxCell id="g_ext" value="External services" style="swimlane;rounded=1;arcSize=4;html=1;whiteSpace=wrap;startSize=28;collapsible=0;fillColor=#eeeeee;swimlaneFillColor=#fafafa;strokeColor=#666666;fontStyle=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="100" width="350" height="970" as="geometry" />
        </mxCell>
        <mxCell id="x_upi" value="&lt;b&gt;UPI apps&lt;/b&gt; (GPay, PhonePe, Paytm …)&lt;br&gt;customer pays from the table QR page by upi:// deep link, then taps “I've paid”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eeeeee;strokeColor=#666666;fontSize=10;spacing=6;" vertex="1" parent="g_ext">
          <mxGeometry x="20" y="30" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="x_agg" value="&lt;b&gt;Swiggy / Zomato / ONDC&lt;/b&gt;&lt;br&gt;signed (HMAC) webhook per channel → order arrives “placed” (or “open” with auto-accept).&lt;br&gt;Manual entry with the external id also works." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eeeeee;strokeColor=#666666;fontSize=10;spacing=6;" vertex="1" parent="g_ext">
          <mxGeometry x="20" y="536" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="x_smtp" value="&lt;b&gt;SMTP provider&lt;/b&gt;&lt;br&gt;any SMTP account (SMTP_*); Mailpit in development;&lt;br&gt;emails are logged as “skipped” when not configured" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eeeeee;strokeColor=#666666;fontSize=10;spacing=6;" vertex="1" parent="g_ext">
          <mxGeometry x="20" y="841" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e_cl_caddy" value="HTTPS · web app + /api/v1 JSON (JWT bearer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b5563;fontSize=10;fontColor=#1f2937;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_clients" target="caddy">
