          <mxGeometry x="792" y="38" width="226" height="206" as="geometry" />
        </mxCell>
        <mxCell id="r_subscription" value="&lt;b&gt;subscription&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;owner renewal · works while locked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_own">
