        </mxCell>
        <mxCell id="r_ai" value="&lt;b&gt;ai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;menu photo OCR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="g_biz">
