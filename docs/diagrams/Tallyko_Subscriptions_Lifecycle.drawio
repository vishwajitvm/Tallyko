        <mxCell id="o1" value="SubscriptionBanner shows days left · a locked app opens the renewal screen (/subscription)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_owner">
          <mxGeometry x="20" y="40" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;GET /api/v1/subscription&lt;/b&gt; (works while locked): state, plans with billing_options, offers shown to owners, payment details (platform_settings.payment)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="140" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="Picks a plan and the number of months; may enter a coupon code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_owner">
          <mxGeometry x="20" y="240" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;POST /subscription/quote&lt;/b&gt;: list price → offer_check (dates, plans, min months, new businesses only, max redemptions) → amount, extra days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="330" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="Pays Tallyko by UPI or bank transfer (outside the app), then sends the reference (UTR)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_owner">
          <mxGeometry x="20" y="440" width="460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;POST /subscription/requests&lt;/b&gt; → subscription_requests (status pending)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="550" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cs" value="&lt;b&gt;Console screens&lt;/b&gt;&lt;br&gt;• Overview: totals, daily-job status, run the check&lt;br&gt;• Businesses → detail: subscriptions, record a payment, give a demo, complimentary period, development access, sign out devices, records&lt;br&gt;• Plans: features (modules), limits, billing options&lt;br&gt;• Offers: subscription offers&lt;br&gt;• Payments: renewal claims&lt;br&gt;• Settings: trial days, grace days, how owners pay&lt;br&gt;• Requests (owner requests) · Tax presets · Audit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=10;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="ln_console">
          <mxGeometry x="20" y="40" width="520" height="330" as="geometry" />
        </mxCell>
        <mxCell id="so" value="&lt;b&gt;Subscription offers&lt;/b&gt; (subscription_offers)&lt;br&gt;percent / flat / none + extra days · plan_keys · min_months · dates · max redemptions · new businesses only · show_to_owners · optional coupon code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=10;spacing=6;" vertex="1" parent="ln_console">
          <mxGeometry x="20" y="390" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Payments&lt;/b&gt; screen: pending claims; check the bank / UPI statement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=10;spacing=6;" vertex="1" parent="ln_console">
          <mxGeometry x="20" y="640" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Payment received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=10;" vertex="1" parent="ln_console">
          <mxGeometry x="170" y="740" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;POST /platform/subscription-requests/{id}/approve&lt;/b&gt; → record_subscription: new period from paid_until, offer redemption counted, lapsed_at cleared, drop_tenant_cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;spacing=6;" vertex="1" parent="ln_api">
          <mxGeometry x="20" y="850" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="reject → status rejected + review note (the owner sees it)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;spacing=6;" vertex="1" parent="ln_console">
          <mxGeometry x="20" y="860" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="Next request works again (no 402); devices the daily check signed out sign in again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;spacing=6;" vertex="1" parent="ln_owner">
